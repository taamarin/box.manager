<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.BoxForRoot" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/material_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/material_blue</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="bg">?attr/colorSurface</item>
        <item name="boldText">?attr/colorOnSurface</item>
        <item name="regularText">?attr/colorOnSurfaceVariant</item>
        <item name="appbar">?attr/colorSurface</item>
        <item name="card">?attr/colorSurfaceVariant</item>
        <item name="appbarAttribute">?attr/colorPrimary</item>
        <item name="hintText">?attr/colorOnSurfaceVariant</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

</resources>